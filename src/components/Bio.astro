---
interface Props {
	lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;

const copy = {
	es: {
		title: 'Wewe',
		p1: 'Wewe es productor musical especializado en urbano, reggaetón y trap, con incursiones en pop alternativo e indie.',
		p2: 'Trabaja en el estudio junto al artista desde la primera idea hasta el master final, dando prioridad a la identidad sonora de cada obra.',
		imgAlt: 'Retrato en blanco y negro de Wewe en el estudio',
	},
	en: {
		title: 'Wewe',
		p1: 'Wewe is a music producer specialized in urban, reggaeton and trap, exploring alt-pop and indie sounds.',
		p2: 'Wewe develops projects in the room from the earliest demo to the final master, prioritizing sonic identity for every record.',
		imgAlt: 'Black and white portrait of Wewe in the studio',
	},
}[lang];
---

<section class="bio-section" id="bio" aria-label="Biografía">
	<div class="wrap bio-grid">
		<div class="bio-media">
			<img
				src="/jared-prod.jpg"
				alt={copy.imgAlt}
				width="3024"
				height="4032"
				loading="lazy"
				class="bio-img"
			/>
		</div>

		<div class="bio-content">
			<h2 class="display bio-title">{copy.title}</h2>
			<div class="bio-text">
				<p>{copy.p1}</p>
				<p>{copy.p2}</p>
			</div>
		</div>
	</div>
</section>

<style>
	.bio-section {
		padding-block: clamp(6rem, 14vw, 12rem);
		border-top: 1px solid var(--line);
	}

	.bio-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--s-7);
		align-items: center;
	}

	@media (min-width: 768px) {
		.bio-grid {
			grid-template-columns: 5fr 7fr;
			gap: var(--s-8);
		}
	}

	.bio-media {
		width: 100%;
		max-width: 440px;
		aspect-ratio: 4 / 5;
		border-radius: var(--r-card);
		overflow: hidden;
		background: var(--surface-1);
		border: 1px solid var(--line);
	}

	.bio-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: grayscale(1) contrast(1.1) brightness(0.85);
		transition: transform 0.6s var(--ease);
	}

	.bio-content {
		display: flex;
		flex-direction: column;
		gap: var(--s-5);
	}

	.bio-title {
		font-size: var(--fs-h2);
	}

	.bio-text {
		display: flex;
		flex-direction: column;
		gap: var(--s-4);
		font-size: var(--fs-lead);
		color: var(--text-muted);
		max-width: 48ch;
		line-height: 1.6;
	}
</style>
