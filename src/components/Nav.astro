---
import Icon from './Icon.astro';

interface Props {
	lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;

const labels = {
	es: {
		productions: 'Producciones',
		beats: 'Beats',
		catalog: 'Catálogo',
		bio: 'Bio',
		requestBeat: 'Pedir beat',
	},
	en: {
		productions: 'Productions',
		beats: 'Beats',
		catalog: 'Catalog',
		bio: 'Bio',
		requestBeat: 'Request beat',
	},
}[lang];
---

<header class="nav-bar glass-surface">
	<div class="wrap nav-container">
		<a href="#top" class="nav-brand" aria-label="Wewe - Inicio">
			<span>Wewe</span>
		</a>

		<nav class="nav-menu" aria-label="Navegación principal">
			<a href="#producciones" class="nav-link">{labels.productions}</a>
			<a href="#beats" class="nav-link">{labels.beats}</a>
			<a href={lang === 'es' ? '/beats' : '/en/beats'} class="nav-link">{labels.catalog}</a>
			<a href="#bio" class="nav-link">{labels.bio}</a>
		</nav>

		<div class="nav-actions">
			<div class="lang-switch" role="group" aria-label="Idioma">
				<span class={`lang-btn ${lang === 'es' ? 'active' : ''}`}>ES</span>
				<span class="lang-divider">/</span>
				<span class={`lang-btn ${lang === 'en' ? 'active' : ''}`}>EN</span>
			</div>

			<a
				href="https://ig.me/m/wewemusicproducer"
				target="_blank"
				rel="noopener noreferrer"
				class="btn btn-secondary nav-cta"
				data-request-beat="General"
			>
				{labels.requestBeat}
			</a>
		</div>
	</div>
</header>

<style>
	.nav-bar {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		height: 64px;
		z-index: var(--z-nav);
		display: flex;
		align-items: center;
		background: var(--glass);
		backdrop-filter: blur(20px) saturate(140%);
		-webkit-backdrop-filter: blur(20px) saturate(140%);
		border-bottom: 1px solid var(--line-alpha);
	}

	.nav-container {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--s-5);
	}

	.nav-brand {
		font-size: 1.25rem;
		font-weight: 600;
		letter-spacing: -0.04em;
		color: var(--text);
		display: flex;
		align-items: center;
	}

	.nav-menu {
		display: flex;
		align-items: center;
		gap: var(--s-6);
	}

	.nav-link {
		color: var(--text-muted);
		font-size: var(--fs-small);
		font-weight: 500;
		transition: color 0.2s var(--ease);
	}

	.nav-link:hover {
		color: var(--text);
	}

	.nav-actions {
		display: flex;
		align-items: center;
		gap: var(--s-4);
	}

	.lang-switch {
		display: inline-flex;
		align-items: center;
		gap: var(--s-1);
		font-size: var(--fs-micro);
		font-weight: 600;
		letter-spacing: 0.05em;
		padding: 4px 10px;
		border-radius: var(--r-pill);
		border: 1px solid var(--line-strong);
		background: var(--surface-1);
	}

	.lang-btn {
		color: var(--text-subtle);
		cursor: default;
	}

	.lang-btn.active {
		color: var(--text);
	}

	.lang-divider {
		color: var(--line-strong);
	}

	.nav-cta {
		padding: 0.5rem 1rem;
		font-size: var(--fs-small);
	}

	@media (max-width: 768px) {
		.nav-menu {
			display: none;
		}
	}
</style>
