---
import Icon from './Icon.astro';

interface Props {
	lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;

const copy = {
	es: {
		heading: 'Empecemos la siguiente producción.',
		btn: 'Escribir por Instagram',
	},
	en: {
		heading: 'Let’s make the next record.',
		btn: 'Message on Instagram',
	},
}[lang];
---

<section class="contact-section" id="contacto" aria-label="Contacto">
	<div class="wrap contact-container">
		<h2 class="display contact-heading">{copy.heading}</h2>
		<div class="contact-action">
			<a
				href="https://ig.me/m/wewemusicproducer"
				target="_blank"
				rel="noopener noreferrer"
				class="btn btn-primary contact-btn"
			>
				<Icon name="InstagramLogo" size={20} />
				<span>{copy.btn}</span>
				<Icon name="ArrowUpRight" size={16} />
			</a>
		</div>
	</div>
</section>

<style>
	.contact-section {
		padding-block: clamp(7rem, 16vw, 14rem);
		border-top: 1px solid var(--line);
	}

	.contact-container {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--s-7);
	}

	.contact-heading {
		font-size: var(--fs-statement);
		max-width: 16ch;
		line-height: 1.1;
	}

	.contact-btn {
		font-size: var(--fs-body);
		padding: 0.9rem 1.8rem;
	}
</style>
