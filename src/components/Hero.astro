---
import Icon from './Icon.astro';

interface Props {
	lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;

const copy = {
	es: {
		headline: 'Sonido que define el',
		headlineEm: 'momento',
		subtext: 'Wewe produce, mezcla y masteriza para artistas que buscan un sonido con carácter propio.',
		listen: 'Escuchar',
		request: 'Pedir beat',
		imgAlt: 'Wewe en el estudio de producción frente a la mesa de mezclas',
	},
	en: {
		headline: 'Sound that shapes the',
		headlineEm: 'moment',
		subtext: 'Wewe produces, mixes and masters for artists who demand their own distinctive sound.',
		listen: 'Listen',
		request: 'Request beat',
		imgAlt: 'Wewe in the music production studio at the mixing console',
	},
}[lang];
---

<section class="hero-section" id="hero">
	<div class="wrap hero-grid">
		<div class="hero-content">
			<h1 class="display hero-title">
				{copy.headline} <em>{copy.headlineEm}</em>.
			</h1>
			<p class="hero-subtext">
				{copy.subtext}
			</p>
			<div class="hero-actions">
				<button type="button" class="btn btn-primary" id="hero-listen-btn" data-play-track="0">
					<Icon name="Play" size={18} />
					<span>{copy.listen}</span>
				</button>
				<a
					href="https://ig.me/m/wewemusicproducer"
					target="_blank"
					rel="noopener noreferrer"
					class="btn btn-secondary"
					data-request-beat="Hero"
				>
					<span>{copy.request}</span>
				</a>
			</div>
		</div>

		<div class="hero-media-wrapper">
			<div class="hero-media">
				<img
					src="https://images.unsplash.com/photo-1598488035139-bdbb2231ce04?q=80&w=1000&auto=format&fit=crop"
					alt={copy.imgAlt}
					width="900"
					height="1125"
					fetchpriority="high"
					loading="eager"
					decoding="async"
					class="hero-img"
				/>
			</div>
		</div>
	</div>
</section>

<style>
	.hero-section {
		min-height: 100dvh;
		display: flex;
		align-items: center;
		padding-top: calc(64px + var(--s-8));
		padding-bottom: var(--s-8);
		position: relative;
	}

	.hero-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--s-7);
		align-items: center;
	}

	@media (min-width: 768px) {
		.hero-grid {
			grid-template-columns: 7fr 5fr;
			gap: var(--s-8);
		}
	}

	.hero-content {
		display: flex;
		flex-direction: column;
		gap: var(--s-6);
	}

	.hero-title {
		font-size: var(--fs-display);
		max-width: 14ch;
	}

	.hero-subtext {
		font-size: var(--fs-lead);
		color: var(--text-muted);
		max-width: 36ch;
		line-height: 1.5;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--s-3);
		align-items: center;
	}

	.hero-media-wrapper {
		width: 100%;
		display: flex;
		justify-content: center;
	}

	@media (min-width: 768px) {
		.hero-media-wrapper {
			justify-content: flex-end;
		}
	}

	.hero-media {
		width: 100%;
		max-width: 480px;
		aspect-ratio: 4 / 5;
		border-radius: var(--r-card);
		overflow: hidden;
		background: var(--surface-1);
		border: 1px solid var(--line);
		position: relative;
	}

	.hero-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: grayscale(1) contrast(1.1) brightness(0.85);
		transition: transform 0.6s var(--ease);
	}

	@media (prefers-reduced-motion: no-preference) {
		@supports (animation-timeline: scroll()) {
			.hero-img {
				animation: hero-drift linear both;
				animation-timeline: scroll(root);
				animation-range: 0 100vh;
			}
			@keyframes hero-drift {
				to {
					transform: translateY(-8%);
				}
			}
		}
	}
</style>
