---
interface Props {
	lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;

const copy = {
	es: {
		text: 'Creado en el estudio, terminado en el detalle.',
		alt: 'Estudio de grabación con monitores y sintetizadores',
	},
	en: {
		text: 'Made in the room, finished in the details.',
		alt: 'Recording studio with studio monitors and synthesizers',
	},
}[lang];
---

<section class="zoom-section" aria-label="Estudio">
	<div class="zoom-pin">
		<div class="zoom-media">
			<img
				src="https://images.unsplash.com/photo-1598488035139-bdbb2231ce04?q=80&w=1920&auto=format&fit=crop"
				alt={copy.alt}
				width="1920"
				height="1080"
				loading="lazy"
				class="zoom-img"
			/>
			<div class="zoom-scrim"></div>
		</div>
		<div class="zoom-content wrap">
			<h2 class="zoom-heading display">{copy.text}</h2>
		</div>
	</div>
</section>

<style>
	.zoom-section {
		height: 240vh;
		position: relative;
	}

	.zoom-pin {
		position: sticky;
		top: 0;
		height: 100dvh;
		display: grid;
		place-items: center;
		overflow: hidden;
	}

	.zoom-media {
		position: absolute;
		inset: 0;
		margin: auto;
		width: 100%;
		height: 100%;
		overflow: hidden;
	}

	.zoom-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: grayscale(1) brightness(0.6) contrast(1.1);
	}

	.zoom-scrim {
		position: absolute;
		inset: 0;
		background: radial-gradient(circle at center, rgb(11 11 13 / 0.4), rgb(11 11 13 / 0.85));
		pointer-events: none;
	}

	.zoom-content {
		position: relative;
		z-index: var(--z-raised);
		text-align: center;
	}

	.zoom-heading {
		font-size: var(--fs-statement);
		max-width: 20ch;
		margin-inline: auto;
		color: var(--text);
		line-height: 1.15;
	}

	@media (prefers-reduced-motion: no-preference) {
		@supports (animation-timeline: view()) {
			.zoom-section {
				view-timeline: --zoom-timeline block;
			}

			.zoom-media {
				animation: zoom-expand linear both;
				animation-timeline: --zoom-timeline;
				animation-range: cover 25vh cover calc(100% - 75vh);
			}

			@keyframes zoom-expand {
				from {
					width: 75%;
					height: 60%;
					border-radius: var(--r-card);
				}
				to {
					width: 100%;
					height: 100%;
					border-radius: 0;
				}
			}

			.zoom-heading {
				animation: zoom-text-in linear both;
				animation-timeline: --zoom-timeline;
				animation-range: cover 40vh cover calc(100% - 50vh);
			}

			@keyframes zoom-text-in {
				from {
					opacity: 0.3;
					transform: translateY(24px);
				}
				to {
					opacity: 1;
					transform: translateY(0);
				}
			}
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.zoom-section {
			height: auto;
			padding-block: var(--s-10);
		}
		.zoom-pin {
			position: static;
			height: 70dvh;
			border-radius: var(--r-card);
		}
	}
</style>
