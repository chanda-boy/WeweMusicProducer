---
import '@fontsource-variable/geist';
import '../../styles/global.css';

import Nav from '../../components/Nav.astro';
import Icon from '../../components/Icon.astro';
import Footer from '../../components/Footer.astro';
import PersistentPlayer from '../../components/PersistentPlayer.astro';
import Toast from '../../components/Toast.astro';

const lang = 'es';

const labels = {
	title: 'Catálogo de beats',
	listen: 'Escuchar',
	request: 'Pedir beat',
	all: 'Todos',
	bpm: 'BPM',
	backToHome: '← Volver al inicio',
	customTitle: 'Producción personalizada',
	customText: 'Wewe produce instrumentales a medida con dirección musical y mezcla dedicada para proyectos discográficos.',
	customCta: 'Escribir por Instagram',
};

const beats = [
	{
		id: 'beat-01',
		title: 'Mañana Sí',
		genre: 'Reggaetón',
		genreFilter: 'Reggaetón',
		mood: 'Nocturno',
		bpm: 96,
		key: 'Fa menor',
		duration: '1:29',
		audioIndex: 4,
		cover: '/audio/manana-si-cover.jpeg',
	},
	{
		id: 'beat-02',
		title: 'Humo',
		genre: 'Trap',
		genreFilter: 'Trap',
		mood: 'Oscuro',
		bpm: 140,
		key: 'Do menor',
		duration: '2:38',
		audioIndex: 5,
		cover: 'https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?q=80&w=200&auto=format&fit=crop',
	},
	{
		id: 'beat-03',
		title: 'Vértigo',
		genre: 'Pop alternativo',
		genreFilter: 'Alt-pop',
		mood: 'Enérgico',
		bpm: 122,
		key: 'Sol mayor',
		duration: '2:45',
		audioIndex: 6,
		cover: 'https://images.unsplash.com/photo-1470225620780-dba8ba36b745?q=80&w=200&auto=format&fit=crop',
	},
	{
		id: 'beat-04',
		title: 'Ceniza',
		genre: 'Trap',
		genreFilter: 'Trap',
		mood: 'Melancólico',
		bpm: 132,
		key: 'Re menor',
		duration: '2:15',
		audioIndex: 5,
		cover: 'https://images.unsplash.com/photo-1514525253161-7a46d19cd819?q=80&w=200&auto=format&fit=crop',
	},
	{
		id: 'beat-05',
		title: 'Eclipse',
		genre: 'Reggaetón',
		genreFilter: 'Reggaetón',
		mood: 'Sensual',
		bpm: 98,
		key: 'La menor',
		duration: '2:50',
		audioIndex: 4,
		cover: 'https://images.unsplash.com/photo-1493225457124-a3eb161ffa5f?q=80&w=200&auto=format&fit=crop',
	},
	{
		id: 'beat-06',
		title: 'Cristal',
		genre: 'Pop alternativo',
		genreFilter: 'Alt-pop',
		mood: 'Etéreo',
		bpm: 118,
		key: 'Mi mayor',
		duration: '2:24',
		audioIndex: 6,
		cover: 'https://images.unsplash.com/photo-1508700115892-45ecd05ae2ad?q=80&w=200&auto=format&fit=crop',
	},
	{
		id: 'beat-07',
		title: 'Neón',
		genre: 'Trap',
		genreFilter: 'Trap',
		mood: 'Pesado',
		bpm: 144,
		key: 'Fa# menor',
		duration: '2:08',
		audioIndex: 5,
		cover: 'https://images.unsplash.com/photo-1518609878373-06d740f60d8b?q=80&w=200&auto=format&fit=crop',
	},
	{
		id: 'beat-08',
		title: 'Gravedad',
		genre: 'Reggaetón',
		genreFilter: 'Reggaetón',
		mood: 'Profundo',
		bpm: 92,
		key: 'Si menor',
		duration: '2:32',
		audioIndex: 4,
		cover: 'https://images.unsplash.com/photo-1511379938547-c1f69419868d?q=80&w=200&auto=format&fit=crop',
	},
];
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#0b0b0d" />
		<meta
			name="description"
			content="Catálogo de instrumentales inéditas producidas por Wewe. Reggaetón, trap y pop alternativo con sonido de estudio."
		/>
		<title>Beats inéditos | Wewe</title>
		<meta property="og:title" content="Beats inéditos | Wewe" />
		<meta
			property="og:description"
			content="Catálogo de instrumentales inéditas producidas por Wewe. Reggaetón, trap y pop alternativo listos para producción discográfica."
		/>
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://wewemusicproducer.com/beats" />
	</head>
	<body>
		<a href="#main-content" class="skip-link">Saltar al contenido</a>

		<Nav lang={lang} />

		<main id="main-content" class="beats-page">
			<div class="wrap">
				<div class="beats-breadcrumb-wrap">
					<a href="/" class="back-link">
						{labels.backToHome}
					</a>
				</div>

				<header class="beats-page-header">
					<h1 class="display beats-page-title">
						Beats <em>inéditos</em>.
					</h1>
					<p class="beats-page-lead">
						Catálogo completo de instrumentales producidas por Wewe. Filtrables por género. Listas para artistas y proyectos discográficos.
					</p>
				</header>

				<div class="beats-toolbar">
					<div class="beats-filters" role="group" aria-label="Filtro por género">
						<button type="button" class="chip active" data-filter="all">{labels.all}</button>
						<button type="button" class="chip" data-filter="Trap">Trap</button>
						<button type="button" class="chip" data-filter="Reggaetón">Reggaetón</button>
						<button type="button" class="chip" data-filter="Alt-pop">Pop alternativo</button>
					</div>
					<div class="beats-count-box">
						<span id="beats-count" class="beats-count tabular">{beats.length} instrumentales</span>
					</div>
				</div>

				<div class="beats-list" id="beats-grid">
					{
						beats.map((beat) => (
							<article class="beat-row" data-genre={beat.genreFilter}>
								<div class="beat-left">
									<div class="beat-thumb">
										<img
											src={beat.cover}
											alt={`Portada de ${beat.title}`}
											width="52"
											height="52"
											loading="lazy"
											decoding="async"
											class="beat-thumb-img"
										/>
									</div>
									<button
										type="button"
										class="btn btn-primary btn-icon beat-play"
										data-play-track={beat.audioIndex}
										aria-label={`${labels.listen} ${beat.title}`}
									>
										<Icon name="Play" size={18} />
									</button>
									<div class="beat-meta-box">
										<h2 class="beat-name">{beat.title}</h2>
										<div class="beat-sub">
											<span class="beat-tag">{beat.genre}</span>
											<span class="meta-dot">·</span>
											<span class="beat-tag">{beat.mood}</span>
											<span class="meta-dot">·</span>
											<span class="tabular">{beat.bpm} {labels.bpm}</span>
											<span class="meta-dot">·</span>
											<span class="tabular">{beat.key}</span>
										</div>
									</div>
								</div>

								<div class="beat-right">
									<span class="beat-duration tabular">{beat.duration}</span>
									<button
										type="button"
										class="btn btn-secondary beat-request-btn"
										data-request-beat={beat.title}
									>
										<Icon name="Copy" size={16} />
										<span>{labels.request}</span>
									</button>
								</div>
							</article>
						))
					}
				</div>

				<section class="custom-prompt-card" aria-label={labels.customTitle}>
					<div class="custom-prompt-content">
						<h2 class="custom-prompt-title">{labels.customTitle}</h2>
						<p class="custom-prompt-desc">
							{labels.customText}
						</p>
					</div>
					<a
						href="https://ig.me/m/wewemusicproducer"
						target="_blank"
						rel="noopener noreferrer"
						class="btn btn-primary custom-prompt-btn"
					>
						<Icon name="InstagramLogo" size={18} />
						<span>{labels.customCta}</span>
						<Icon name="ArrowUpRight" size={16} />
					</a>
				</section>
			</div>
		</main>

		<Footer lang={lang} />

		<PersistentPlayer lang={lang} />
		<Toast lang={lang} />

		<script>
			const filterButtons = document.querySelectorAll('.beats-filters .chip');
			const beatRows = document.querySelectorAll('.beat-row');
			const countEl = document.getElementById('beats-count');

			function updateVisibility() {
				const activeBtn = document.querySelector('.beats-filters .chip.active');
				const selectedFilter = activeBtn ? activeBtn.getAttribute('data-filter') : 'all';
				let visibleCount = 0;

				beatRows.forEach((row) => {
					const rowGenre = row.getAttribute('data-genre');
					const matchesFilter = selectedFilter === 'all' || rowGenre === selectedFilter;

					if (matchesFilter) {
						(row as HTMLElement).style.display = 'flex';
						visibleCount++;
					} else {
						(row as HTMLElement).style.display = 'none';
					}
				});

				if (countEl) {
					countEl.textContent = `${visibleCount} ${visibleCount === 1 ? 'instrumental' : 'instrumentales'}`;
				}
			}

			filterButtons.forEach((btn) => {
				btn.addEventListener('click', () => {
					filterButtons.forEach((b) => b.classList.remove('active'));
					btn.classList.add('active');
					updateVisibility();
				});
			});
		</script>
	</body>
</html>

<style>
	.beats-page {
		min-height: 100dvh;
		padding-top: calc(64px + var(--s-7));
		padding-bottom: calc(72px + var(--s-9));
	}

	.beats-breadcrumb-wrap {
		margin-bottom: var(--s-5);
	}

	.back-link {
		font-size: var(--fs-small);
		color: var(--text-subtle);
		transition: color 0.2s var(--ease);
		display: inline-flex;
		align-items: center;
	}

	.back-link:hover {
		color: var(--text);
	}

	.beats-page-header {
		display: flex;
		flex-direction: column;
		gap: var(--s-4);
		margin-bottom: var(--s-7);
		max-width: 58ch;
	}

	.beats-page-title {
		font-size: var(--fs-h2);
		line-height: 1.1;
	}

	.beats-page-title em {
		font-style: italic;
		font-weight: 600;
		color: var(--text);
		display: inline-block;
		padding-bottom: 0.08em;
		line-height: 1.1;
	}

	.beats-page-lead {
		font-size: var(--fs-lead);
		color: var(--text-muted);
		line-height: 1.55;
	}

	.beats-toolbar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--s-4);
		margin-bottom: var(--s-6);
		padding-bottom: var(--s-4);
		border-bottom: 1px solid var(--line);
	}

	.beats-filters {
		display: flex;
		flex-wrap: wrap;
		gap: var(--s-2);
	}

	.beats-count-box {
		display: flex;
		align-items: center;
	}

	.beats-count {
		font-size: var(--fs-micro);
		color: var(--text-subtle);
	}

	.beats-list {
		display: flex;
		flex-direction: column;
		gap: var(--s-3);
		margin-bottom: var(--s-9);
	}

	.beat-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: var(--s-4);
		padding: var(--s-4) var(--s-5);
		background: var(--surface-1);
		border: 1px solid var(--line);
		border-radius: var(--r-card);
		transition: background-color 0.2s var(--ease), border-color 0.2s var(--ease);
	}

	.beat-row:hover {
		background: var(--surface-2);
		border-color: var(--line-strong);
	}

	.beat-left {
		display: flex;
		align-items: center;
		gap: var(--s-4);
		flex: 1 1 auto;
	}

	.beat-thumb {
		width: 52px;
		height: 52px;
		border-radius: var(--r-card);
		overflow: hidden;
		flex-shrink: 0;
		background: var(--surface-2);
		border: 1px solid var(--line);
	}

	.beat-thumb-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: grayscale(1) contrast(1.1) brightness(0.85);
		transition: transform 0.4s var(--ease), filter 0.4s var(--ease);
	}

	.beat-row:hover .beat-thumb-img {
		filter: grayscale(0.8) contrast(1.1) brightness(0.95);
		transform: scale(1.04);
	}

	.beat-play {
		flex-shrink: 0;
	}

	.beat-meta-box {
		display: flex;
		flex-direction: column;
		gap: var(--s-1);
	}

	.beat-name {
		font-size: var(--fs-h3);
		font-weight: 600;
		color: var(--text);
		letter-spacing: -0.02em;
		margin: 0;
	}

	.beat-sub {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--s-2);
		font-size: var(--fs-micro);
		color: var(--text-subtle);
	}

	.beat-tag {
		color: var(--text-muted);
	}

	.meta-dot {
		color: var(--line-strong);
	}

	.beat-right {
		display: flex;
		align-items: center;
		gap: var(--s-5);
	}

	.beat-duration {
		font-size: var(--fs-small);
		color: var(--text-subtle);
	}

	.beat-request-btn {
		font-size: var(--fs-small);
		padding: 0.55rem 1.1rem;
	}

	.custom-prompt-card {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--s-6);
		padding: var(--s-7) var(--s-8);
		background: var(--surface-1);
		border: 1px solid var(--line-strong);
		border-radius: var(--r-card);
	}

	.custom-prompt-content {
		max-width: 48ch;
		display: flex;
		flex-direction: column;
		gap: var(--s-2);
	}

	.custom-prompt-title {
		font-size: var(--fs-h3);
		font-weight: 600;
		color: var(--text);
		letter-spacing: -0.02em;
	}

	.custom-prompt-desc {
		font-size: var(--fs-body);
		color: var(--text-muted);
		line-height: 1.5;
	}

	.custom-prompt-btn {
		font-size: var(--fs-small);
		padding: 0.8rem 1.6rem;
		flex-shrink: 0;
	}

	@media (max-width: 640px) {
		.beat-row {
			flex-direction: column;
			align-items: flex-start;
		}
		.beat-right {
			width: 100%;
			justify-content: space-between;
			margin-top: var(--s-2);
		}
		.custom-prompt-card {
			padding: var(--s-5);
		}
	}
</style>
